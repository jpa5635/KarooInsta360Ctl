<?xml version="1.0" encoding="utf-8"?>
<!-- Wrapped in a ScrollView: the Karoo's screen is much smaller than a phone's,
     and this layout has grown past what fits on it without scrolling — buttons
     were being silently clipped off-screen rather than actually missing. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cameras"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/noCamerasText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No cameras saved yet — scan or add one below."
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/cameraListContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configuration Profiles"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="All heart rate/power/speed/radar trigger settings live on a profile, not on a camera. Each profile also chooses which of your saved cameras it considers at all — Configure a profile to pick its cameras and set each one's triggers. Applying a profile makes it the one driving automatic recording, so switching between e.g. a Road and a Gravel race profile reconfigures the whole fleet's behavior in one tap."
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/activeProfileText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="Active profile: none"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/noProfilesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No profiles saved yet — add a camera above, then create one below."
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/profileListContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/saveNewProfileButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create New Profile"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add a Camera"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shows every nearby Bluetooth device, not just Insta360 cameras — tap Add on whichever one is yours."
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/scanForCamerasButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan for Cameras"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/discoveredListContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Or add by address (if scanning doesn't find it)"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/manualNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Camera name (e.g. Chest, Handlebar)"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/manualAddressInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Camera BLE address (AA:BB:CC:DD:EE:FF)"
            android:inputType="textCapCharacters"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/manualAddButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add by Address" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notifications"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/notifyOnRecordingChangeCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notify when a camera starts or stops recording"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="Posts a notification in the status bar/drawer for every start and stop, whether triggered automatically or from a camera's Start/Stop test buttons — applies to all saved cameras. On Android 13+ this will prompt for notification permission the first time you turn it on."
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ride Page Fields"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/darkFieldThemeCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dark theme for this extension's data fields"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="Applies to the Recording Control tile and the Insta360 Distance field. Karoo doesn't tell an extension whether your ride pages are light or dark, so this has to be set here to match. Full-width and half-width layouts are handled automatically from whichever cell you drop the field into."
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/batteryColorCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Colour the Recording Control tile by camera battery level"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="Off: the tile turns solid red while any camera is recording. On: each recording camera gets an even stripe of the tile coloured by its battery level - green above 80%, then yellow-green, yellow, orange, red below 20% and purple below 10%. Cameras that aren't recording get no stripe, so a coloured tile still means recording either way. Up to three cameras are shown."
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data Source Loss"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="If a camera is recording because of an automatic trigger (heart rate, power, speed, or radar) and that trigger's own data source stops updating entirely — a disconnected strap, a dead sensor, lost radar connectivity — the trigger has no way to tell effort or speed actually dropped, and would otherwise keep that recording going forever. Set how long to tolerate a missing data source before treating it as lost and stopping the recording automatically; any other still-live trigger on the same camera is unaffected and can keep it recording on its own. 0 disables this and waits indefinitely (the old behavior)."
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/dataSourceLossTimeoutInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:hint="Minutes (0 = never stop)" />

            <Button
                android:id="@+id/saveDataSourceLossTimeoutButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="In-Ride Manual Control"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="Two ways to start/stop every saved camera at once, both unaffected by Hammerhead's rule hiding Control Center notifications for the whole duration of a ride: the tappable &quot;INSTA CTRL&quot; data field, which you can drop on any ride page, and the &quot;Toggle Camera Recording&quot; action, assignable to a controller button in the Karoo's own button settings. (A Control Center Start/Stop control used to be a third option here — removed since it's hidden for the entire ride by platform design, making it useless for exactly the case this section is about.) A recording started either of these ways (or from a camera's own Configure screen, its own physical shutter button, or after using Reconnect) is never auto-stopped by the automatic triggers — only a recording the triggers themselves started gets auto-stopped, so this protection lasts as long as the recording does, with nothing you need to do to keep it in effect. Stopping a camera this way briefly (a few seconds) pauses its automatic triggers so they can't immediately start it right back up if a trigger condition is still true — that pause always clears itself shortly after, whether or not you ever open that camera's Configure screen."
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
