<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews for the "Distance" data field (see RecordingDistanceDataType.kt).

     Label and value are stacked in a LinearLayout rather than layered in the FrameLayout,
     so on a quarter-height cell the label takes its space off the top and the value gets
     what's left, instead of overlapping the digits.

     (2026-09-10) The top row carries per-camera battery percentages on the left with the
     field label pushed to the right edge (layout_weight on the label, gravity=end).

     (2026-09-11) There is no recording dot here any more. It began as a single
     corner-pinned dot, then became one tinted dot per camera, then a dot stacked under
     each percentage — and at every size it cost horizontal or vertical room this cell does
     not have, which is what was truncating the label. The percentage itself now blinks
     while that camera is recording, which says the same thing in no space at all. Battery
     colour lives on the Recording Control tile; this field is numbers only.

     Three camera slots are declared, matching that tile's stripe cap. Slots for cameras
     that aren't connected are GONE and collapse completely. Blinking toggles between
     VISIBLE and INVISIBLE, never GONE, so a recording camera's neighbours don't shuffle
     sideways twice a second. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recordingDistanceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/distanceTopRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/batteryPct1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="sans-serif"
                android:textFontWeight="300"
                android:textScaleX="0.8"
                android:textSize="11sp"
                android:visibility="gone"
                android:text="--%" />

            <TextView
                android:id="@+id/batteryPct2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="sans-serif"
                android:textFontWeight="300"
                android:textScaleX="0.8"
                android:textSize="11sp"
                android:visibility="gone"
                android:text="--%" />

            <TextView
                android:id="@+id/batteryPct3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="sans-serif"
                android:textFontWeight="300"
                android:textScaleX="0.8"
                android:textSize="11sp"
                android:visibility="gone"
                android:text="--%" />

            <!-- Weight here is what right-justifies the label: it absorbs whatever the
                 percentages don't use, and gravity=end pins the text to the far edge. -->
            <TextView
                android:id="@+id/distanceLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="sans-serif"
                android:textFontWeight="700"
                android:textScaleX="0.8"
                android:textSize="11sp"
                android:text="DISTANCE" />

        </LinearLayout>

        <!-- Weight, not family, is the lever on this device.
             /system/etc/fonts.xml remaps "sans-serif" to IBM Plex Sans with non-standard
             weight mappings: 100=Thin, 200=Light, 300=Regular, 400=Medium, 700=SemiBold,
             900=Bold. A TextView defaults to weight 400, so we were rendering in IBM Plex
             *Medium* while Karoo's own fields use Regular — that was the extra thickness.
             textFontWeight=300 selects Regular under this mapping.

             Note that fontFamily can't fix this: "sans-serif-light", "sans-serif-thin" and
             "sans-serif-condensed" are all aliased straight to "sans-serif" here with no
             weight override, so they resolve to the same Medium face. The 0.1.20 change to
             sans-serif-light was a no-op for exactly that reason.

             If Regular still reads heavy, 200 gives Light.

             (2026-09-11) textScaleX: 0.92 -> 1.0 -> 0.90. The earlier note that it
             condenses "without touching the stroke" is wrong — the transform applies to the
             rendered glyph, so a vertical stem narrows by exactly the same factor. That is
             the whole difficulty here: at matching height the stock field is about 10%
             narrower than this one, and the only lever we have narrows the strokes by the
             same amount, which is what read as slightly-less-bold at 0.92.

             0.90 is set because width was the complaint that mattered more. If the stroke
             now looks thin again, the real fix is not this attribute but the genuinely
             condensed face on this device, "ibm-plex-sans-condensed" — a designed condensed
             font narrows the glyph while keeping the stem, and it ships at weight 600,
             which would also add back some of the thickness. It was passed over earlier on
             the assumption that 600 would be too heavy; that assumption was made when we
             were trying to get *thinner*, and is worth retesting now that we want narrower
             without thinner. -->
        <TextView
            android:id="@+id/distanceValue"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="true"
            android:maxLines="1"
            android:fontFamily="sans-serif"
            android:textFontWeight="300"
            android:textStyle="normal"
            android:textScaleX="0.90"
            android:textSize="28sp"
            android:text="--" />

    </LinearLayout>

</FrameLayout>
