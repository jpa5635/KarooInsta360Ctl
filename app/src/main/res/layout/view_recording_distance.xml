<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews for the "Distance" data field (see RecordingDistanceDataType.kt).

     (2026-09-07) This now draws the distance value itself, in distanceValue. The first
     version relied on UpdateGraphicConfig(formatDataTypeId = TYPE_DISTANCE_ID) to have
     Karoo render the number underneath our overlay, which is what that setting is
     documented to do — but on device the cell came up with no number at all, so the field
     draws its own. See the class doc for the reasoning.

     Two pre-positioned dots rather than one repositioned dot: RemoteViews can't change a
     child's layout_gravity, and setViewLayoutWidth/Height is API 31+ (minSdk here is 26),
     so the code toggles visibility to pick a side instead. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recordingDistanceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <TextView
        android:id="@+id/distanceValue"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textStyle="bold"
        android:textSize="28sp"
        android:text="--" />

    <ImageView
        android:id="@+id/recordingDistanceDotStart"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="start|top"
        android:visibility="gone"
        android:contentDescription="@string/recording_dot_description"
        android:src="@drawable/ic_rec_dot_on_dark" />

    <ImageView
        android:id="@+id/recordingDistanceDotEnd"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="end|top"
        android:visibility="gone"
        android:contentDescription="@string/recording_dot_description"
        android:src="@drawable/ic_rec_dot_on_dark" />

</FrameLayout>
