<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews for the "Distance" data field (see RecordingDistanceDataType.kt).

     Label and value are stacked in a LinearLayout rather than layered in the FrameLayout,
     so on a quarter-height cell the label takes its space off the top and the value gets
     what's left, instead of overlapping the digits.

     (2026-09-10) The top row now carries per-camera battery percentages on the left with
     the field label pushed to the right edge (layout_weight on the label, gravity=end).
     Each camera gets a recording dot immediately left of its percentage, tinted to that
     camera's battery band — replacing the single corner-pinned dot this field used to
     have, which no longer had a free corner to live in and couldn't say *which* camera was
     rolling.

     Three camera slots are declared, matching the Recording Control field's stripe cap.
     Slots for cameras that aren't connected are set GONE and collapse completely; a
     connected camera that isn't recording keeps its dot INVISIBLE rather than GONE, so
     starting a recording doesn't shove its percentage sideways. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recordingDistanceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/distanceTopRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/batterySlot1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/batteryPct1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:fontFamily="sans-serif"
                    android:textFontWeight="300"
                    android:textScaleX="0.8"
                    android:textSize="11sp"
                    android:text="--%" />

                <ImageView
                    android:id="@+id/batteryDot1"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="1dp"
                    android:padding="1dp"
                    android:background="@drawable/bg_dot_ring_dark"
                    android:contentDescription="@string/recording_dot_description"
                    android:src="@drawable/ic_rec_dot_solid" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/batterySlot2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/batteryPct2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:fontFamily="sans-serif"
                    android:textFontWeight="300"
                    android:textScaleX="0.8"
                    android:textSize="11sp"
                    android:text="--%" />

                <ImageView
                    android:id="@+id/batteryDot2"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="1dp"
                    android:padding="1dp"
                    android:background="@drawable/bg_dot_ring_dark"
                    android:contentDescription="@string/recording_dot_description"
                    android:src="@drawable/ic_rec_dot_solid" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/batterySlot3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/batteryPct3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:fontFamily="sans-serif"
                    android:textFontWeight="300"
                    android:textScaleX="0.8"
                    android:textSize="11sp"
                    android:text="--%" />

                <ImageView
                    android:id="@+id/batteryDot3"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="1dp"
                    android:padding="1dp"
                    android:background="@drawable/bg_dot_ring_dark"
                    android:contentDescription="@string/recording_dot_description"
                    android:src="@drawable/ic_rec_dot_solid" />

            </LinearLayout>

            <!-- Weight here is what right-justifies the label: it absorbs whatever the
                 percentages don't use, and gravity=end pins the text to the far edge. -->
            <TextView
                android:id="@+id/distanceLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="sans-serif"
                android:textFontWeight="700"
                android:textScaleX="0.8"
                android:textSize="11sp"
                android:text="DISTANCE" />

        </LinearLayout>

        <!-- Weight, not family, is the lever on this device.
             /system/etc/fonts.xml remaps "sans-serif" to IBM Plex Sans with non-standard
             weight mappings: 100=Thin, 200=Light, 300=Regular, 400=Medium, 700=SemiBold,
             900=Bold. A TextView defaults to weight 400, so we were rendering in IBM Plex
             *Medium* while Karoo's own fields use Regular — that was the extra thickness.
             textFontWeight=300 selects Regular under this mapping.

             Note that fontFamily can't fix this: "sans-serif-light", "sans-serif-thin" and
             "sans-serif-condensed" are all aliased straight to "sans-serif" here with no
             weight override, so they resolve to the same Medium face. The 0.1.20 change to
             sans-serif-light was a no-op for exactly that reason.

             If Regular still reads heavy, 200 gives Light.

             Width is a separate axis from weight: textScaleX condenses the glyphs
             horizontally without touching the stroke. Used here in preference to the one
             genuinely condensed family on the device, "ibm-plex-sans-condensed", because
             that ships only at weight 600 — switching to it would undo the weight fix
             above and bring the thickness straight back. -->
        <TextView
            android:id="@+id/distanceValue"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="true"
            android:maxLines="1"
            android:fontFamily="sans-serif"
            android:textFontWeight="300"
            android:textStyle="normal"
            android:textScaleX="0.74"
            android:textSize="28sp"
            android:text="--" />

    </LinearLayout>

</FrameLayout>
