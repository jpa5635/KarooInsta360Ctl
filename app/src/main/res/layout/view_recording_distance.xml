<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews for the "Distance" data field (see RecordingDistanceDataType.kt).

     Label and value are stacked in a LinearLayout rather than layered in the FrameLayout,
     so on a quarter-height cell the label takes its space off the top and the value gets
     what's left, instead of overlapping the digits.

     (2026-09-10) The top row carries per-camera battery percentages on the left with the
     field label pushed to the right edge (layout_weight on the label, gravity=end).

     (2026-09-11) There is no recording dot here any more. It began as a single
     corner-pinned dot, then became one tinted dot per camera, then a dot stacked under
     each percentage — and at every size it cost horizontal or vertical room this cell does
     not have, which is what was truncating the label. The percentage itself now blinks
     while that camera is recording, which says the same thing in no space at all. Battery
     colour lives on the Recording Control tile; this field is numbers only.

     Three camera slots are declared, matching that tile's stripe cap. Slots for cameras
     that aren't connected are GONE and collapse completely. Blinking toggles between
     VISIBLE and INVISIBLE, never GONE, so a recording camera's neighbours don't shuffle
     sideways twice a second. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recordingDistanceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/distanceTopRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/batteryPct1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="sans-serif"
                android:textFontWeight="300"
                android:textScaleX="0.8"
                android:textSize="11sp"
                android:visibility="gone"
                android:text="--%" />

            <TextView
                android:id="@+id/batteryPct2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="sans-serif"
                android:textFontWeight="300"
                android:textScaleX="0.8"
                android:textSize="11sp"
                android:visibility="gone"
                android:text="--%" />

            <TextView
                android:id="@+id/batteryPct3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="sans-serif"
                android:textFontWeight="300"
                android:textScaleX="0.8"
                android:textSize="11sp"
                android:visibility="gone"
                android:text="--%" />

            <!-- Weight here is what right-justifies the label: it absorbs whatever the
                 percentages don't use, and gravity=end pins the text to the far edge. -->
            <TextView
                android:id="@+id/distanceLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="sans-serif"
                android:textFontWeight="700"
                android:textScaleX="0.8"
                android:textSize="11sp"
                android:text="DISTANCE" />

        </LinearLayout>

        <!-- includeFontPadding is false here to match every other TextView in this file.
             It was true, with no reason recorded, and that was the gap: the flag reserves
             the font's full ascent AND descent, and these are digits, which have no
             descender to reserve for. The reserved-but-unused band sat between the label
             row and the number, which is why the spacing looked wider than a native Karoo
             field's.

             THE FONT (2026-09-11, finally). The value uses "monospace", which on this
             device is NOT a typewriter face — /system/etc/fonts.xml declares:

               <family name="monospace">
                   <font weight="400" style="normal">Relative12-Regular.otf</font>
               </family>
               <alias name="relative" to="monospace" />

             and that file's internal name is "Hammerhead Relative 12 Regular". It is
             Hammerhead's own commissioned typeface, on the device for no other reason than
             that their UI draws with it. Everything from 0.1.36 to 0.1.59 was an attempt to
             match it with a different family and then correct the mismatch by squashing.

             Why the earlier candidates were wrong, so nobody re-tries them:

               sans-serif                -> IBM Plex Sans. Too wide; squashing it thins the
                                            stems (textScaleX scales the rendered glyph, so
                                            width and stroke move together) and never gives
                                            narrow-with-full-stroke.
               sans-serif-condensed      -> aliased straight back to sans-serif. A no-op.
               ibm-plex-sans-condensed   -> a real condensed face, but the family holds only
                                            IBMPlexSansCondensed-Medium.otf, so every weight
                                            request lands on Medium and it reads heavy.
               bundled IBM Plex Cond Reg -> right weight, right shape, still the wrong face:
                                            digits are 540/1000 em against Relative's 500.

             Relative is 7% narrower in the digits at the same size with a near-identical
             cap height (700 vs 698), which is most of the width the textScaleX values were
             chasing — now had for free, without thinning anything. So textScaleX is gone
             from the value again, and the bundled font and its licence are deleted.

             Tabular figures come free: the family is monospace, so every digit already has
             the same advance and no fontFeatureSettings is needed.

             If the numerals still look off after this, the difference is NOT the family —
             it is size (VALUE_SIZE_RATIO), weight, or something outside this TextView. -->
        <TextView
            android:id="@+id/distanceValue"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:fontFamily="monospace"
            android:textStyle="normal"
            android:textSize="28sp"
            android:text="--" />

    </LinearLayout>

</FrameLayout>
