<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/profileTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="Check a camera to include it in this profile, then use Configure Triggers to set its heart rate/power/speed/radar values for this profile specifically. Unchecking a camera doesn't erase its settings — they're kept for next time you switch it back on."
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/profileNoCamerasText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No cameras saved yet — add one from the main screen first."
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/profileCameraListContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
