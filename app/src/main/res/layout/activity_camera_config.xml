<?xml version="1.0" encoding="utf-8"?>
<!-- Camera identity screen only (2026-08-29, build 0.1.9) — trigger configuration moved
     to ProfileCameraConfigActivity/activity_profile_camera_config.xml; see
     CameraConfigActivity's doc comment. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/configAddressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/configNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Camera name"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/configStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="Manually test this camera's Start/Stop, independent of any automatic trigger. Automatic triggers are paused for this camera while this screen is open."
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/configStartButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/configStopButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stop" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="This camera's heart rate/power/speed/radar trigger settings are configured per profile now, not here — open a profile from the main screen and use its Configure button."
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/saveConfigButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Name"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/removeCameraButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remove This Camera" />

    </LinearLayout>
</ScrollView>
