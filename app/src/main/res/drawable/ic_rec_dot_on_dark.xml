<?xml version="1.0" encoding="utf-8"?>
<!-- Recording dot for the Recording Distance field, dark-theme variant: red fill with a
     light ring so it stays visible against the dark field background Karoo draws the
     numeric distance on. See RecordingDistanceDataType. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/recording_dot" />
    <stroke
        android:width="1dp"
        android:color="#FFFFFF" />
</shape>
