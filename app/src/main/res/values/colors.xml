<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Used for the InRideAlert dispatched on a genuine recording start/stop — see
         Insta360Extension's connectionListener. Green/red-ish so "started" and "stopped"
         read at a glance without needing to read the text. -->
    <color name="recording_started_bg">#2E7D32</color>
    <color name="recording_stopped_bg">#455A64</color>
    <color name="recording_alert_text">#FFFFFF</color>

    <!-- Added (2026-09-07) for the graphical ride-page fields. The recording background
         is deliberately a deep red rather than a bright one: it fills a whole data field
         cell, and a saturated red at that size is hard to read white text on in direct
         sun. -->
    <color name="field_recording_bg">#C1121F</color>
    <color name="field_dark_bg">#40000000</color>
    <color name="field_light_bg">#F2FFFFFF</color>
    <color name="field_dark_text">#FFFFFF</color>
    <color name="field_light_text">#111111</color>
    <color name="field_recording_text">#FFFFFF</color>
    <color name="recording_dot">#FF2D2D</color>

    <!-- Added (2026-09-10) — battery level bands. See camera/CameraBattery.kt for the
         percentage boundaries these map to. Used as the fill for the Recording Control
         field's per-camera stripes and as the tint for the Insta360 Distance field's
         per-camera recording dots.

         The yellow is deliberately not a true yellow: field_light_bg is #F2FFFFFF, and
         #FFEB3B against that is close to invisible in daylight. The red is also *not*
         field_recording_bg, so a red battery band and the plain "recording" treatment
         can't be confused when the battery-colour option is switched off. -->
    <color name="battery_full">#2E7D32</color>
    <color name="battery_high">#7CB342</color>
    <color name="battery_medium">#F2C200</color>
    <color name="battery_low">#EF6C00</color>
    <color name="battery_critical">#D32F2F</color>
    <color name="battery_depleted">#7B1FA2</color>

    <!-- Backing for the text box the Recording Control field draws over its stripes, and
         the ring behind a tinted recording dot. Near-opaque rather than translucent: at
         50% alpha the same box reads differently over #F2C200 than over #7B1FA2, and the
         text contrast would shift with the battery level. -->
    <color name="field_box_dark_bg">#F2101010</color>
    <color name="field_box_light_bg">#F2FFFFFF</color>
</resources>
