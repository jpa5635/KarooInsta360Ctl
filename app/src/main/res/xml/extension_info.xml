<?xml version="1.0" encoding="utf-8"?>
<ExtensionInfo
    displayName="@string/extension_name"
    icon="@drawable/ic_extension"
    id="insta360cam"
    scansDevices="false">

    <DataType
        typeId="recording_state"
        displayName="Insta360 Recording"
        description="1 while ANY saved camera is recording, 0 when none are"
        graphical="false"
        icon="@drawable/ic_extension" />

    <!-- displayName is what Karoo draws as this tile's header on the ride page, since
         unlike the distance field this one doesn't suppress the header and draw its own.
         Short on purpose: the header eats height from a cell whose whole job is a big
         tappable target, and a long name wraps or truncates there. Note the same string is
         what you look for in the field picker. -->
    <DataType
        typeId="recording_control"
        displayName="INSTA CTRL"
        description="Tap to start every connected camera, or stop every recording one"
        graphical="true"
        icon="@drawable/ic_extension" />

    <DataType
        typeId="recording_distance"
        displayName="@string/recording_distance_name"
        description="@string/recording_distance_description"
        graphical="true"
        icon="@drawable/ic_extension" />

    <BonusAction
        actionId="toggle_recording"
        displayName="@string/action_toggle_recording" />

</ExtensionInfo>
