<?xml version="1.0" encoding="utf-8"?>
<ExtensionInfo
    displayName="@string/extension_name"
    icon="@drawable/ic_extension"
    id="insta360cam"
    scansDevices="false">

    <DataType
        typeId="recording_state"
        displayName="Insta360 Recording"
        description="1 while ANY saved camera is recording, 0 when none are"
        graphical="false"
        icon="@drawable/ic_extension" />

    <DataType
        typeId="recording_control"
        displayName="Insta360 Recording Control"
        description="Tap to start every connected camera, or stop every recording one"
        graphical="true"
        icon="@drawable/ic_extension" />

    <BonusAction
        actionId="toggle_recording"
        displayName="@string/action_toggle_recording" />

</ExtensionInfo>
